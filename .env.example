# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (e-mail)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Rezuma <noreply@yourdomain.com>

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-secret

# App
APP_ENV=production
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://your-railway-app.railway.app

# Alertas operacionais, e-mail do desenvolvedor (deixe vazio para desativar)
ADMIN_EMAIL=

# Chave secreta para o endpoint /admin/run-pipeline, gere com: openssl rand -hex 32
ADMIN_SECRET_KEY=

# Formulário de contato. O aviso sai por SMTP comum para não gastar a cota do
# Resend. No Gmail, a senha é uma "senha de app", não a senha da conta.
CONTACT_EMAIL=contatorezuma@gmail.com
SMTP_USER=contatorezuma@gmail.com
SMTP_PASSWORD=
