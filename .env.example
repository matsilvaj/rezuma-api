# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Resend (e-mail)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Rezuma <noreply@yourdomain.com>

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-secret

# App
APP_ENV=production
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://your-railway-app.railway.app

# Alertas operacionais, e-mail do desenvolvedor (deixe vazio para desativar)
ADMIN_EMAIL=

# Chave secreta para o endpoint /admin/run-pipeline, gere com: openssl rand -hex 32
ADMIN_SECRET_KEY=

# Formulário de contato: as mensagens chegam no Telegram de quem mantém.
# Bot separado do que entrega os resumos.
CONTACT_BOT_TOKEN=
CONTACT_CHAT_ID=
